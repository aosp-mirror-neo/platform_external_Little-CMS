cc_library_shared {
    name: "liblcms2",

    sdk_version: "current",
    visibility: [
        "//vendor:__subpackages__",
        "//external/libcupsfilters",
    ],

    local_include_dirs: [
        "include",
    ],

    srcs: [
        "src/cmscnvrt.c",
        "src/cmserr.c",
        "src/cmsgamma.c",
        "src/cmsgmt.c",
        "src/cmsintrp.c",
        "src/cmsio0.c",
        "src/cmsio1.c",
        "src/cmslut.c",
        "src/cmsplugin.c",
        "src/cmssm.c",
        "src/cmsmd5.c",
        "src/cmsmtrx.c",
        "src/cmspack.c",
        "src/cmspcs.c",
        "src/cmswtpnt.c",
        "src/cmsxform.c",
        "src/cmssamp.c",
        "src/cmsnamed.c",
        "src/cmscam02.c",
        "src/cmsvirt.c",
        "src/cmstypes.c",
        "src/cmscgats.c",
        "src/cmsps2.c",
        "src/cmsopt.c",
        "src/cmshalf.c",
        "src/cmsalpha.c",
    ],

    export_include_dirs: [
        "include",
    ],
}
